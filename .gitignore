# ==================================================
# Environment / secrets — never commit real .env files
# ==================================================
.env
.env.*
!.env.example
!*/.env.example

# ==================================================
# Python (backend)
# ==================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Local data the backend writes at runtime (Chroma persistence, etc.)
backend/data/
*.sqlite3

# ==================================================
# Node / frontend
# ==================================================
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==================================================
# IDE / editor
# ==================================================
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ==================================================
# OS-generated files
# ==================================================
.DS_Store
Thumbs.db
Desktop.ini
