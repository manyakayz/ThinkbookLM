# Copy this file to `.env` in the backend/ directory and adjust values as needed.
# `.env` itself is gitignored and must never be committed.

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Comma-separated list of origins allowed to call this API (e.g. the Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL ---
POSTGRES_DSN=postgresql://thinkbook:thinkbook@localhost:5432/thinkbook_lm

# --- ChromaDB ---
CHROMA_PERSIST_DIR=./data/chroma

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_BATCH_SIZE=16

# --- Document Ingestion ---
DOCUMENT_STORAGE_DIR=./data/documents
MAX_UPLOAD_SIZE_MB=25
ALLOWED_FILE_TYPES=pdf,docx,txt
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=200

# --- Retrieval ---
RETRIEVAL_TOP_K=5
