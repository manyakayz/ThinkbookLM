# Copy this file to `.env` in the backend/ directory and adjust values as needed.
# `.env` itself is gitignored and must never be committed.

# --- App ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
# Comma-separated list of origins allowed to call this API (e.g. the Vite dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL ---
# Full connection string. Not yet required to have a running database for the
# backend to start in this milestone; the connection is only opened lazily.
POSTGRES_DSN=postgresql://thinkbook:thinkbook@localhost:5432/thinkbook_lm

# --- ChromaDB ---
# Local, on-disk persistence directory. No server needs to be running for
# this milestone; the client is created lazily on first use.
CHROMA_PERSIST_DIR=./data/chroma

# --- Ollama ---
# Base URL of a locally running Ollama instance and the model name that will
# be used for generation in later milestones. Not required to be running yet.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
