# Copy this file to `.env` in the frontend/ directory if you need it.
#
# In development the Vite dev server proxies `/api/*` requests to the
# FastAPI backend (see vite.config.js), so no env var is required to run
# locally. This is here for when the frontend is built for production and
# served separately from the API, at which point requests will need an
# absolute backend URL instead of the dev proxy.

VITE_API_BASE_URL=http://localhost:8000
